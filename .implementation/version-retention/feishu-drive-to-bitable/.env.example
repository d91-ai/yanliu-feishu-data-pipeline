# Advanced reference containing every supported setting. For the default path,
# start from .env.router.example and .env.meeting-minutes.example instead.
# Do not commit or share real env files. Enable compatibility routes only when
# required by the deployment and verify them independently.

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# If your environment already uses Lark naming, LARK_APP_ID and LARK_APP_SECRET
# are also accepted by the CLI.

# Target Drive folder / Bitable.
# FEISHU_FOLDER_TOKEN is the source root folder. In month-split mode it is the
# parent of source month folders, for example 未审核/2032-08.
FEISHU_FOLDER_TOKEN=
# Optional explicit source month folder tokens. The service also reads
# FEISHU_FOLDER_REGISTRY_PATH and keeps FEISHU_FOLDER_TOKEN as fallback.
FEISHU_SOURCE_FOLDER_TOKENS=
FEISHU_ARCHIVE_ROOT_FOLDER_TOKEN=
FEISHU_FOLDER_REGISTRY_PATH=data/folder_registry.json
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# Required when FEISHU_PIPELINE_MODE=unified. Bind logical field keys to
# stable field IDs in this private manifest.
FEISHU_FIELD_BINDINGS_PATH=

# Keep open_id unless your Bitable people fields require user_id.
FEISHU_USER_ID_TYPE=open_id

# Start with dry run. Set to false only after event and field mapping are verified.
FEISHU_DRY_RUN=true
FEISHU_LOG_LEVEL=INFO

# Archive workflow endpoint. Use a random shared token; do not use App Secret.
# Keep FEISHU_ARCHIVE_DRY_RUN=true until one-record production testing is approved.
FEISHU_ARCHIVE_HTTP_ENABLED=false
FEISHU_ARCHIVE_HTTP_HOST=127.0.0.1
FEISHU_ARCHIVE_HTTP_PORT=8787
FEISHU_ARCHIVE_HTTP_TOKEN=
FEISHU_ARCHIVE_ALLOW_NO_TOKEN=false
FEISHU_ARCHIVE_DRY_RUN=true
FEISHU_ARCHIVE_REVIEW_FIELD=已审核
FEISHU_ARCHIVE_ORIGINAL_TIME_FIELD=原始记录时间
FEISHU_ARCHIVE_FILE_LINK_FIELD=文档链接
FEISHU_ARCHIVE_FILE_NAME_FIELD=文件名
FEISHU_ARCHIVE_STATUS_FIELD=归档状态
FEISHU_ARCHIVE_LINK_FIELD=归档链接
FEISHU_VERSION_BASELINE_LINK_FIELD=审核前版本链接
FEISHU_ARCHIVE_TIME_FIELD=归档时间
FEISHU_ARCHIVE_TIMEZONE_OFFSET_HOURS=8
FEISHU_ARCHIVE_MAX_BODY_BYTES=16384
FEISHU_EVENT_SPOOL_DIR=data/event-spool
FEISHU_PIPELINE_EVENT_NOT_BEFORE_MS=0

# Native Base form attachment ingress (unified mode only; disabled by default).
# FEISHU_FORM_ATTACHMENT_FIELD is a manifest logical key, not a live name.
FEISHU_FORM_INGRESS_ENABLED=false
FEISHU_FORM_ATTACHMENT_FIELD=会议纪要上传附件
FEISHU_FORM_MAX_ATTACHMENT_BYTES=10485760
FEISHU_GENERATION_JOB_SPOOL_DIR=data/meeting-generation-jobs
FEISHU_FORM_INGESTION_RECEIPT_DIR=data/meeting-ingestion-receipts

# Review before/after version retention. Production values may be loaded from
# data/version_retention.json per table, avoiding duplicated route config.
FEISHU_VERSION_CONFIG_PATH=data/version_retention.json
FEISHU_VERSION_CAPTURE_ENABLED=true
FEISHU_VERSION_CAPTURE_ENFORCE=true
FEISHU_VERSION_ROOT_FOLDER_TOKEN=
FEISHU_VERSION_CATEGORY=

# Structured-review routes only: fail closed unless the uploaded Markdown has
# the generator's schema-v2 frontmatter, then create the Base row with source,
# meeting, viewpoint-count, review, and archive metadata in one write.
FEISHU_STRUCTURED_METADATA_ENABLED=false

# Meeting-minutes source routes only: validate the current meeting-minutes
# output contract before any Base record is created. Pin the validator bytes.
FEISHU_MEETING_CONTRACT_ENABLED=false
FEISHU_MEETING_CONTRACT_VALIDATOR=/skills/investment-meeting-minutes/scripts/validate_meeting_minutes_contract.py
FEISHU_MEETING_CONTRACT_VALIDATOR_SHA256=
# Docker Compose host bind used by router/minutes services.
MEETING_MINUTES_SKILL_HOST_DIR=/absolute/path/to/installed/investment-meeting-minutes-skill

# Optional: add aliases for your actual field names without editing code.
# Supported keys:
# file_link, file_name, upload_time, uploader, owner, file_type,
# file_token, folder_token, source, event_time
# FEISHU_FIELD_ALIASES_JSON={"file_link":["文档链接"],"upload_time":["创建日期"]}
