# Non-secret identifiers
FEISHU_APP_ID=
FEISHU_SANITIZE_BITABLE_APP_TOKEN=
FEISHU_SANITIZE_SOURCE_TABLE_ID=
FEISHU_SANITIZE_TARGET_TABLE_ID=
FEISHU_SANITIZE_PENDING_ROOT_FOLDER_TOKEN=
FEISHU_SANITIZE_ARCHIVE_ROOT_FOLDER_TOKEN=
FEISHU_SANITIZE_VERSION_ROOT_FOLDER_TOKEN=
FEISHU_SANITIZE_SOURCE_CUTOFF=2032-07-13 00:00

# Host paths. Keep secret values in these files, never in .env.
FEISHU_APP_SECRET_HOST_FILE=
FEISHU_SANITIZE_HTTP_TOKEN_HOST_FILE=
SANITIZE_SKILL_HOST_DIR=

# Runtime contract. The mounted skill may be absent/incompatible; health then
# reports skill_ready=false and review-Markdown generation fails closed. The
# approval archive endpoint remains available because it does not invoke skill.
SANITIZE_SKILL_COMMAND_JSON=["python","/skills/meeting-minutes-sanitizer/scripts/sanitize_minutes.py"]
SANITIZE_SKILL_CONTRACT_VERSION=minute-sanitization/v2
SANITIZE_SKILL_SOURCE_REVISION=
SANITIZE_SKILL_SCRIPT_SHA256=
SANITIZE_SKILL_TIMEOUT_SECONDS=180
SANITIZE_MAX_INPUT_BYTES=10485760

FEISHU_SANITIZE_HTTP_HOST=127.0.0.1
FEISHU_SANITIZE_HTTP_PORT=8791
FEISHU_LOG_LEVEL=INFO
