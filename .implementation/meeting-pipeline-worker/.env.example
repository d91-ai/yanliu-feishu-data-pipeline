# Unified Feishu backend candidate. Keep disabled until the production cutover
# has been explicitly authorized and the worker service entrypoint is reviewed.
FEISHU_UNIFIED_PIPELINE_ENABLED=false

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MEETING_BASE_APP_TOKEN=
FEISHU_MEETING_BASE_TABLE_ID=
FEISHU_OUTPUT_OWNER_OPEN_ID=
FEISHU_USER_ID_TYPE=open_id
FEISHU_OPENAPI_BASE=https://open.feishu.cn/open-apis

# Current publication roots.
FEISHU_PARENT_FOLDER_TOKEN=
FEISHU_PIPELINE_INDUSTRY_MD_FOLDER_TOKEN=
FEISHU_PIPELINE_INDUSTRY_JSON_FOLDER_TOKEN=
FEISHU_PIPELINE_STRUCTURED_MD_FOLDER_TOKEN=
FEISHU_PIPELINE_STRUCTURED_JSON_FOLDER_TOKEN=

# Immutable evidence and superseded-file roots.
FEISHU_PIPELINE_BASELINE_FOLDER_TOKEN=
FEISHU_PIPELINE_REVIEWED_FOLDER_TOKEN=
FEISHU_PIPELINE_HISTORY_FOLDER_TOKEN=

# Persistent local state. Use absolute paths on the deployment host.
FEISHU_GENERATION_JOB_SPOOL_PATH=data/meeting-generation-jobs
FEISHU_PIPELINE_REVIEW_JOB_SPOOL_DIR=data/pipeline-review-jobs
FEISHU_PIPELINE_WORKER_RECEIPT_DIR=data/meeting-pipeline-receipts
FEISHU_PIPELINE_WORKER_LOCK_PATH=data/unified-worker.lock
FEISHU_PIPELINE_WORK_DIR=data/work
FEISHU_PIPELINE_ARTIFACT_REGISTRY_PATH=data/artifact-registry.json
FEISHU_PIPELINE_RECORD_LOCK_DIR=data/record-locks
FEISHU_PIPELINE_FOLDER_REGISTRY_PATH=data/folder-registry.json
FEISHU_PIPELINE_OUTPUT_DIR=data/outputs

# Runtime assets. Production should use reviewed absolute paths.
MEETING_PIPELINE_CONTRACT_PATH=
MEETING_PIPELINE_CONTRACT_SHA256=
MEETING_PIPELINE_CONTRACT_RUNTIME_SHA256=
FEISHU_STRUCTURED_SERVICE_ROOT=
FEISHU_STRUCTURED_SERVICE_SHA256=
FEISHU_STRUCTURED_SERVICE_CONTRACT_SHA256=
INDUSTRY_MARKET_SKILL_ROOT=
INDUSTRY_MARKET_SKILL_MANIFEST_SHA256=
INDUSTRY_MARKET_SKILL_SCRIPT_SHA256=
INDUSTRY_MARKET_SKILL_RUNTIME_SHA256=
STRUCTURED_SKILL_ROOT=
STRUCTURED_SKILL_MANIFEST_SHA256=
STRUCTURED_SKILL_SCRIPT_SHA256=
STRUCTURED_SKILL_RUNTIME_SHA256=
SPEAKER_MASTER_PATH=
FEISHU_PIPELINE_CODEX_BIN=codex
FEISHU_PIPELINE_MODEL=codex-cli-default
FEISHU_PIPELINE_MODEL_REASONING_EFFORT=medium
FEISHU_PIPELINE_MODEL_TIMEOUT_SECONDS=1800

# Host-local health/readiness and polling.
FEISHU_PIPELINE_WORKER_POLL_SECONDS=2
FEISHU_PIPELINE_WORKER_HTTP_HOST=127.0.0.1
FEISHU_PIPELINE_WORKER_HTTP_PORT=8792
