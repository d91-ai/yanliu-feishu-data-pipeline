<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.example.researchpipeline.feishu-meeting-pipeline-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/CHANGE_ME/services/feishu-meeting-pipeline-worker/unified_worker_service.py</string>
    <string>--env-file</string>
    <string>/Users/CHANGE_ME/services/feishu-meeting-pipeline-worker/.env</string>
    <string>serve</string>
    <string>--apply</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/CHANGE_ME/services/feishu-meeting-pipeline-worker</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/CHANGE_ME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/CHANGE_ME/services/feishu-meeting-pipeline-worker/data/worker.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGE_ME/services/feishu-meeting-pipeline-worker/data/worker.err.log</string>
</dict>
</plist>
