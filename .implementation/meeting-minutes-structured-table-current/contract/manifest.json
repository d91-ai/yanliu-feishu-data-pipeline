{
  "contract_version": 9,
  "schema_version": 9,
  "semantic_prompt": "semantic_prompt.md",
  "claim_units_schema": "claim_units.schema.json",
  "provider_claim_units_schema": "claim_units.provider.schema.json",
  "viewpoints_schema": "viewpoints.schema.json",
  "security_master": {
    "cli_flag": "--security-master",
    "default_path": "data/security_master.csv",
    "format": "csv",
    "required_columns": ["target_name", "stock_code", "market", "aliases"],
    "resolution": "initial-name-match;reviewed-code-preserved",
    "version": "sha256-of-csv-bytes",
    "refresh_owner": "repository-scheduled-job",
    "runtime_network": false
  },
  "speaker_master": {
    "cli_flag": "--speaker-master",
    "format": "csv",
    "required_columns": ["presenter_id", "canonical_name", "aliases", "status"],
    "resolution": "confirmed-exact-unique;fallback-original",
    "runtime_network": false
  },
  "entrypoints": {
    "generate_table": "scripts/generate_table.py"
  },
  "runtime_paths": [
    "SKILL.md",
    "agents/openai.yaml",
    "contract/claim_units.schema.json",
    "contract/claim_units.provider.schema.json",
    "contract/manifest.json",
    "contract/semantic_prompt.md",
    "contract/viewpoints.schema.json",
    "data/security_master.csv",
    "references/schema.md",
    "structured_table/__init__.py",
    "structured_table/application.py",
    "structured_table/claims.py",
    "structured_table/common.py",
    "structured_table/contract.py",
    "structured_table/official_json.py",
    "structured_table/review_codec.py",
    "structured_table/security_master.py",
    "structured_table/speaker_master.py",
    "structured_table/source_document.py",
    "scripts/generate_table.py"
  ]
}
