# Meeting-minutes route. App credentials are inherited from .env.router.
FEISHU_FOLDER_TOKEN=
FEISHU_ARCHIVE_ROOT_FOLDER_TOKEN=
FEISHU_FOLDER_REGISTRY_PATH=data/folder_registry_meeting_minutes.json
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# Used only by the optional five-Workflow provisioning helper. Keep the real
# open_id in the untracked local env file, never in Git.
FEISHU_WORKFLOW_REVIEWER_OPEN_ID=
FEISHU_WORKFLOW_REVIEWER_NAME=审核人
# Required in unified mode. The mounted manifest maps stable Router logical
# keys to Base field IDs; live field names are resolved dynamically.
FEISHU_FIELD_BINDINGS_PATH=/app/.field-bindings.meeting-minutes.json

# Keep legacy until the unified Base, worker, and migration have passed the
# separately authorized production cutover gate.
FEISHU_PIPELINE_MODE=legacy
FEISHU_UNREGISTERED_FILE_SPOOL_DIR=data/unregistered-files
FEISHU_PIPELINE_REVIEW_JOB_SPOOL_DIR=data/pipeline-review-jobs
FEISHU_PIPELINE_WORKER_RECEIPT_DIR=data/meeting-pipeline-receipts
# Set once, after historical Base migration, to the current epoch milliseconds.
# Older change events are ignored instead of being treated as new approvals.
FEISHU_PIPELINE_EVENT_NOT_BEFORE_MS=0

# Native Base form attachment ingress is opt-in and requires unified mode.
# This is a manifest logical key, not a live Base field-name binding.
FEISHU_FORM_INGRESS_ENABLED=false
FEISHU_FORM_ATTACHMENT_FIELD=会议纪要上传附件
FEISHU_FORM_MAX_ATTACHMENT_BYTES=10485760
FEISHU_GENERATION_JOB_SPOOL_DIR=data/meeting-generation-jobs
FEISHU_FORM_INGESTION_RECEIPT_DIR=data/meeting-ingestion-receipts

FEISHU_DRY_RUN=true
# The unified Worker owns version retention. Keep the legacy archive HTTP route off.
FEISHU_ARCHIVE_HTTP_ENABLED=false
FEISHU_ARCHIVE_HTTP_PORT=8787
FEISHU_ARCHIVE_HTTP_TOKEN=
FEISHU_ARCHIVE_DRY_RUN=true
FEISHU_ARCHIVE_REVIEW_FIELD=已审核
FEISHU_ARCHIVE_ORIGINAL_TIME_FIELD=会议日期

FEISHU_VERSION_CAPTURE_ENABLED=true
FEISHU_VERSION_CAPTURE_ENFORCE=true
FEISHU_VERSION_ROOT_FOLDER_TOKEN=
FEISHU_VERSION_CATEGORY=meeting-minutes

FEISHU_MEETING_CONTRACT_ENABLED=true
FEISHU_MEETING_CONTRACT_VALIDATOR=/skills/investment-meeting-minutes/scripts/validate_meeting_minutes_contract.py
FEISHU_MEETING_CONTRACT_VALIDATOR_SHA256=
