# Optional structured-table compatibility route. App credentials are inherited
# from .env.router. Keep disabled unless the deployment still uses this route.
FEISHU_FOLDER_TOKEN=
FEISHU_ARCHIVE_ROOT_FOLDER_TOKEN=
FEISHU_FOLDER_REGISTRY_PATH=data/folder_registry_structured.json
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

FEISHU_DRY_RUN=true
FEISHU_ARCHIVE_HTTP_ENABLED=true
FEISHU_ARCHIVE_HTTP_PORT=8787
FEISHU_ARCHIVE_HTTP_TOKEN=
FEISHU_ARCHIVE_DRY_RUN=true
FEISHU_ARCHIVE_REVIEW_FIELD=已审核
FEISHU_ARCHIVE_ORIGINAL_TIME_FIELD=会议日期

FEISHU_VERSION_CAPTURE_ENABLED=true
FEISHU_VERSION_CAPTURE_ENFORCE=true
FEISHU_VERSION_ROOT_FOLDER_TOKEN=
FEISHU_VERSION_CATEGORY=structured-table

FEISHU_STRUCTURED_METADATA_ENABLED=true
