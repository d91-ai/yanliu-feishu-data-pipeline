{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/meeting-minutes-industry-market-viewpoints/claim-units-v3.json",
  "title": "Industry and market viewpoint claim units",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "claim_ref",
      "source_refs",
      "view_scope",
      "subject",
      "presenter",
      "view_type",
      "viewpoint_text"
    ],
    "properties": {
      "claim_ref": {
        "type": "string",
        "pattern": "^c[0-9]{3,}$"
      },
      "source_refs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^L[0-9]{3,}$"
        }
      },
      "view_scope": {
        "type": "string",
        "enum": [
          "market",
          "industry"
        ]
      },
      "subject": {
        "type": "string",
        "minLength": 1
      },
      "presenter": {
        "type": "string",
        "minLength": 1
      },
      "view_type": {
        "type": "string",
        "enum": [
          "看多",
          "看空",
          "中性"
        ]
      },
      "viewpoint_text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
